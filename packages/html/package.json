{
  "name": "@vyaz/html",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "node": "./dist/index.js",
      "browser": "./dist/index.browser.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun --external @vyaz/core && bun build ./src/index.browser.ts --outdir ./dist --outfile ./dist/index.browser.js --target browser --external @vyaz/core && tsc -b",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@vyaz/core": "^0.2.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@vyaz/renderer": "^0.2.1",
    "linkedom": "^0.18.13",
    "typescript": "^5.4.0"
  }
}
