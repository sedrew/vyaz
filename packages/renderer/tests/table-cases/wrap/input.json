{
  "table": {
    "columnWidths": [
      120
    ],
    "rows": [
      {
        "cells": [
          {
            "content": {
              "wrap": true,
              "paragraphs": [
                {
                  "style": {
                    "alignment": "left",
                    "lineHeight": 1.3,
                    "spaceBefore": 0,
                    "spaceAfter": 0
                  },
                  "children": [
                    {
                      "type": "text",
                      "text": "a rather long piece of cell text that will need to wrap",
                      "fontFamily": "Unifont",
                      "fontSize": 16,
                      "fontWeight": "normal",
                      "fontStyle": "normal",
                      "color": "#111111"
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    ]
  },
  "renders": {
    "browser": {
      "preset": "browser"
    }
  }
}
