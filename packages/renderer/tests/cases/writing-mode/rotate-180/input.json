{
  "profile": "frame-fit",
  "frame": {
    "wrap": true,
    "width": 260,
    "height": 90,
    "rotation": 180,
    "paragraphs": [
      {
        "children": [
          {
            "text": "Upside-down caption, rotated 180 degrees about the frame centre.",
            "type": "text",
            "fontFamily": "Unifont",
            "fontSize": 14,
            "fontWeight": 400,
            "fontStyle": "normal",
            "color": "#222"
          }
        ],
        "style": {
          "alignment": "left",
          "lineHeight": 1.3,
          "spaceBefore": 0,
          "spaceAfter": 0,
          "whiteSpace": "normal"
        }
      }
    ]
  },
  "renders": {
    "flat": {
      "debug": { "frameBox": true, "contentBox": true },
      "preset": "flat"
    },
    "browser": {
      "debug": { "frameBox": true, "contentBox": true },
      "preset": "browser"
    }
  }
}
