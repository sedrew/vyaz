{
  "profile": "frame-fit",
  "frame": {
    "wrap": true,
    "width": 150,
    "height": 240,
    "writingMode": "sideways-rl",
    "paragraphs": [
      {
        "children": [
          {
            "text": "Vertical label ",
            "type": "text",
            "fontFamily": "Unifont",
            "fontSize": 15,
            "fontWeight": 700,
            "fontStyle": "normal",
            "color": "#111"
          },
          {
            "text": "turned 90 degrees clockwise, wrapping by the frame height.",
            "type": "text",
            "fontFamily": "Unifont",
            "fontSize": 15,
            "fontWeight": 400,
            "fontStyle": "normal",
            "color": "#444"
          }
        ],
        "style": {
          "alignment": "left",
          "lineHeight": 1.3,
          "spaceBefore": 0,
          "spaceAfter": 0,
          "whiteSpace": "normal"
        }
      }
    ]
  },
  "renders": {
    "flat": {
      "debug": { "frameBox": true, "contentBox": true },
      "preset": "flat"
    },
    "browser": {
      "debug": { "frameBox": true, "contentBox": true },
      "preset": "browser"
    }
  }
}
