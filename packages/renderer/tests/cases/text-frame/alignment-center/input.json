{
  "env": "arial",
  "profile": "frame-fit",
  "frame": {
    "wrap": true,
    "width": 400,
    "paragraphs": [
      {
        "children": [
          {
            "text": "Hello",
            "type": "text"
          }
        ],
        "style": {
          "alignment": "center",
          "lineHeight": 1.15,
          "spaceBefore": 0,
          "spaceAfter": 0,
          "whiteSpace": "normal"
        }
      }
    ]
  },
  "renders": {
    "flat": {
      "debug": {
        "frameBox": true,
        "contentBox": true
      },
      "preset": "flat"
    },
    "browser": {
      "debug": {
        "frameBox": true,
        "contentBox": true
      },
      "preset": "browser"
    },
    "preserve": {
      "debug": {
        "frameBox": true,
        "contentBox": true
      },
      "preset": "preserve"
    },
    "glyph": {
      "debug": {
        "frameBox": true,
        "contentBox": true
      },
      "preset": "glyph"
    }
  }
}
